# Secure defaults. Production supports local accounts only and refuses disabled auth.
PAPERPILOT_ENV=production
PAPERPILOT_AUTH_MODE=local
PAPERPILOT_COOKIE_SECURE=true

# Translation worker connection. The authentication token is a separate file,
# never an environment variable. Compose mounts it from deploy/paperpilot-worker.token.
PAPERPILOT_TRANSLATION_WORKER_URL=http://paperpilot-translation-worker:7192
PAPERPILOT_TRANSLATION_JOBS_ROOT=/work/jobs
PAPERPILOT_WORKER_TOKEN_FILE=/run/secrets/paperpilot_worker_token
PAPERPILOT_SETTINGS_KEY_FILE=/run/secrets/paperpilot_settings_key

# Isolated Document Worker. Its separate token is mounted from
# deploy/paperpilot-document-worker.token and is never placed in this file.
PAPERPILOT_DOCUMENT_WORKER_URL=http://paperpilot-document-worker:7193
PAPERPILOT_DOCUMENT_JOBS_ROOT=/work/document-jobs
PAPERPILOT_DOCUMENT_WORKER_TOKEN_FILE=/run/secrets/paperpilot_document_worker_token
PAPERPILOT_MAX_PDF_BYTES=104857600
PAPERPILOT_MAX_ARCHIVE_BYTES=209715200
PAPERPILOT_MAX_ARCHIVE_EXPANDED_BYTES=2147483648
PAPERPILOT_MAX_ARCHIVE_ENTRIES=2000
PAPERPILOT_MAX_IMPORT_PAPERS=500

# Optional bootstrap origins. After v0.9.0 starts, administrators approve public
# HTTPS Providers in the web UI without changing this file or restarting.
PAPERPILOT_AI_ALLOWED_ORIGINS=https://api.openai.com
# Private HTTP(S) targets must be individually approved; loopback and link-local
# addresses remain forbidden even when listed.
PAPERPILOT_AI_PRIVATE_ALLOWED_ORIGINS=
# Optional RFC 2544 range used by transparent DNS fake-IP proxies. This only
# applies to administrator-approved public HTTPS hostnames; IP-literal and LAN
# destinations remain forbidden. Leave empty unless DNS returns 198.18.0.0/15.
PAPERPILOT_AI_PROXY_FAKE_IP_RANGES=
# Exact public origins used by MinerU pre-signed upload/result URLs.
PAPERPILOT_MINERU_TRANSFER_ALLOWED_ORIGINS=

# arXiv-only proxy. Leave empty to connect directly.
# Use ARXIV_PROXY for both HTTP and HTTPS arXiv URLs, or set scheme-specific
# values below. These variables are only applied to arxiv.org/export.arxiv.org.
ARXIV_PROXY=
ARXIV_API_PROXY=
ARXIV_HTTP_PROXY=
ARXIV_HTTPS_PROXY=
