# Secure defaults. Production refuses to start if Supabase or the allowlist is empty.
PAPERPILOT_ENV=production
PAPERPILOT_AUTH_MODE=supabase
PAPERPILOT_ALLOWED_EMAILS=admin@example.com
PAPERPILOT_COOKIE_SECURE=true

# Supabase Configuration (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# arXiv-only proxy. Leave empty to connect directly.
# Use ARXIV_PROXY for both HTTP and HTTPS arXiv URLs, or set scheme-specific
# values below. These variables are only applied to arxiv.org/export.arxiv.org.
ARXIV_PROXY=
ARXIV_API_PROXY=
ARXIV_HTTP_PROXY=
ARXIV_HTTPS_PROXY=
